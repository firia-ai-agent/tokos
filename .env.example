# Tokos local / Vercel environment
# Copy to .env.local. Demo mode works without paid vendor keys.

# Required
DATABASE_URL=postgres://tokos:tokos_local@127.0.0.1:5432/tokos
AUTH_SECRET=
AUTH_URL=http://127.0.0.1:43127
AUTH_TRUST_HOST=true

# App
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43127
DEMO_MODE=true

# Cron (Vercel Cron sends this as Authorization: Bearer)
CRON_SECRET=change-me-in-production

# Neon Launch (production). Local demo uses the DATABASE_URL above.
# USE_NEON_HTTP=1

# Stripe — omit to use Checkout stub
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Dropbox Sign Essentials — omit to use redirect stub
DROPBOX_SIGN_API_KEY=
DROPBOX_SIGN_CLIENT_ID=

# Resend — omit to drain outbox to the stub (console + DB)
RESEND_API_KEY=
RESEND_FROM=Tokos <hello@localhost>

# S3 — omit to store FileObject metadata only (no upload)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
